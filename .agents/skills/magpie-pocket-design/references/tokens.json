{
  "product": "Magpie Pocket",
  "version": "1.1",
  "units": {
    "layout": "dp",
    "typography": "sp",
    "duration": "ms"
  },
  "colors": {
    "light": {
      "background": "#F6F7FB",
      "surface": "#FFFFFF",
      "textPrimary": "#202330",
      "textSecondary": "#6D7283",
      "divider": "#E8EAF1",
      "accent": "#5E59D9",
      "accentSurface": "#EEEDFC",
      "success": "#237A61",
      "warning": "#986116",
      "error": "#BD4852",
      "glassTint": "#FFFFFF",
      "glassAlpha": 0.74,
      "surfaceSubtle": "#F0F1F6",
      "textTertiary": "#9297A6"
    },
    "dark": {
      "background": "#101217",
      "surface": "#1A1E26",
      "textPrimary": "#EEF0F6",
      "textSecondary": "#A5ACBC",
      "divider": "#2D3340",
      "accent": "#B0AAFF",
      "accentSurface": "#2C2947",
      "success": "#7AD7B5",
      "warning": "#F3BF71",
      "error": "#FF969F",
      "glassTint": "#272C3A",
      "glassAlpha": 0.82,
      "surfaceSubtle": "#222733",
      "textTertiary": "#777F91"
    }
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32
  ],
  "layout": {
    "referenceWidth": 390,
    "minimumTestWidth": 320,
    "pagePadding": 20,
    "compactPagePadding": 16,
    "touchTargetMinimum": 48,
    "navigationHeight": 68,
    "navigationHorizontalMargin": 16,
    "navigationBottomGapAboveInset": 8,
    "contentExtraBottomPadding": 16,
    "twoPaneThreshold": 600
  },
  "radius": {
    "dataPanel": 24,
    "selector": 20,
    "search": 20,
    "bottomNavigation": 32,
    "sheetTop": 28
  },
  "typography": {
    "pageTitle": {
      "size": 28,
      "lineHeight": 34,
      "weight": 700
    },
    "heroMetric": {
      "size": 36,
      "lineHeight": 40,
      "weight": 600
    },
    "inlineMetric": {
      "size": 24,
      "lineHeight": 28,
      "weight": 600
    },
    "body": {
      "size": 14,
      "lineHeight": 20,
      "weight": 400
    },
    "label": {
      "size": 12,
      "lineHeight": 16,
      "weight": 400
    },
    "navigation": {
      "size": 12,
      "lineHeight": 16,
      "weight": 400
    },
    "sectionTitle": {
      "size": 17,
      "lineHeight": 22,
      "weight": 600
    },
    "sheetTitle": {
      "size": 21,
      "lineHeight": 26,
      "weight": 600
    },
    "subhead": {
      "size": 13,
      "lineHeight": 18,
      "weight": 400
    }
  },
  "icons": {
    "regular": 22,
    "range": [
      20,
      24
    ],
    "brand": "bird",
    "brandArtwork": "Lucide bird",
    "brandLicense": "ISC",
    "retainAttribution": true
  },
  "glass": {
    "defaultMode": "clear",
    "implementation": "layered_tint_highlight_and_shadow",
    "minimumApi": 24,
    "clear": {
      "lightAlpha": 0.74,
      "darkAlpha": 0.82
    },
    "tinted": {
      "alpha": 0.9
    },
    "solid": {
      "alpha": 1.0
    },
    "highlightBorderDp": 0.75,
    "dataPanelOpaque": true,
    "maximumActiveScreenFractionTarget": 0.25,
    "neverBlurForeground": true,
    "requiresOpticalBlur": false
  },
  "motion": {
    "tabDurationRange": [
      180,
      240
    ],
    "sheetDurationRange": [
      220,
      280
    ],
    "pressedScaleMinimum": 0.98,
    "respectReducedMotion": true
  },
  "displayRules": {
    "quotaWarningUsedRatio": 0.85,
    "accountMaskingDefault": true,
    "missingNumericValue": null,
    "ttftDefaultStatistic": "arithmetic_mean",
    "rerouteCounterUnit": "handoff_count"
  },
  "controls": {
    "switch": {
      "minimumTouchTargetDp": 48,
      "minimumThumbTrackContrast": 3.0,
      "checkedTrackToken": "accent",
      "checkedThumbLight": "#FFFFFF",
      "checkedThumbDark": "#101217",
      "uncheckedTrackToken": "surfaceSubtle",
      "uncheckedThumbToken": "textSecondary",
      "allStatesExplicit": true
    }
  },
  "routing": {
    "mode": "automatic_live_request",
    "manualGroupPicker": false,
    "idleLabel": "等待路由请求",
    "directRouteLabel": "直接路由",
    "historyPinnedUntilReturnLive": true
  }
}
